unity/Assets/Sounds/final_god.wav*
media/

# Other people's code and raw downloads, kept only locally
ref/
model/src/

# Test screenshots (a few are copied to docs/)
shots/

# One-off patch scripts from development
tools/patch_*.py
tools/fix_static.py
tools/*.cs.txt

# Release downloads (attached to GitHub Releases, not committed)
release/
unity-release.log
